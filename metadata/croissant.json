  "@type": "sc:Dataset",
  "@id": "build_and_find_scratch_task_pack_v1",
  "name": "Build and Find Scratch Task Pack and Canonical Analysis Tables",
  "description": "Machine-readable metadata for the Build and Find final-study scratch task pack, question banks, canonical analysis tables with run-level manifests, and derived analysis reports.",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://anonymous.4open.science/r/Build-and-Find/",
  "version": "1.0.0",
  "dateCreated": "2026-05-01",
  "datePublished": "2026-05-04",
  "dateModified": "2026-05-07",
  "creator": [
    {
      "@type": "sc:Person",
      "name": "Build and Find Authors"
    }
  ],
  "citation": {
    "@type": "sc:CreativeWork",
    "name": "Build and Find: A benchmark for coding-agent project legibility and intent recovery",
    "url": "https://anonymous.4open.science/r/Build-and-Find/"
  },
  "citeAs": "Build and Find: A benchmark for coding-agent project legibility and intent recovery. NeurIPS 2026 Evaluations and Datasets submission.",
  "keywords": [
    "coding agents",
    "benchmark",
    "intent recovery",
    "software engineering",
    "agent evaluation"
  ],
  "isAccessibleForFree": true,
  "isLiveDataset": false,
  "includedInDataCatalog": {
    "@type": "sc:DataCatalog",
    "name": "Build and Find Repository",
    "url": "https://anonymous.4open.science/r/Build-and-Find/"
  },
  "rai:dataLimitations": [
    "The released task pack contains two Rust build-from-scratch task families and is high-prior: accuracy is a validity gate and calibration signal, not a standalone artifact-quality leaderboard.",
    "Conditional inspection effort is an agent-facing proxy for builder artifact quality only after recovery and stability gates are satisfied.",
    "Builder-finder affinity is panel-local and diagnostic; it should not be interpreted as a universal model-family ranking.",
    "Broad model ranking, language-general claims, runtime correctness, deployment safety, security, and human maintainability require separate evidence.",
    "Empirical claims are panel-local to the frozen builder and finder systems, CLI adapters, prompts, seeds, and benchmark harness recorded in the release manifests.",
    "Multiple-choice Find questions intentionally preserve ordinary software-engineering priors; question-only and spec-only controls quantify but do not remove those priors.",
    "Released task content may enter future model training data. Contamination-resistant follow-up studies should use private task packs with the same schema."
  ],
  "rai:dataBiases": [
    "The task pack is Rust-only and emphasizes systems-programming artifacts: an SQL-subset database and an HTTP framework.",
    "Question banks focus on source-traceable implementation intent, protocol choices, and failure modes, which may underrepresent other kinds of software legibility.",
    "The final model panel is limited to the recorded Codex and Claude Code adapters and model families; results should not be generalized to all coding agents without new trials."
  ],
  "rai:personalSensitiveInformation": [
    "No human-subject data, demographic attributes, health data, political or religious beliefs, or other personal or sensitive information are intentionally included.",
    "Generated run tables identify synthetic task ids, model ids, adapter ids, seeds, prompt hashes, environment hashes, and benchmark metrics; they do not include user personal data."
  ],
  "rai:dataUseCases": [
    "Recommended use: evaluating generated coding-agent artifacts by artifact-evidenced recovery of specification-traced design intent within a calibrated finder-task panel.",
    "Recommended use: validating finder panels, inspecting analysis scripts, reproducing canonical tables and derived reports, and comparing new agents against the frozen evidence contract.",
    "Not recommended use: certifying deployment safety, security, runtime correctness beyond the recorded compile probe, human maintainability, public-task-pack leaderboards, or universal single-axis model rankings."
  ],
  "rai:dataSocialImpact": "The dataset can improve transparency around coding-agent collaboration by making artifact legibility and inspection effort measurable. Misuse risks include overgeneralizing panel-local benchmark scores, treating compile-probe artifacts as deployment-ready software, or optimizing agents narrowly for released public tasks. The release mitigates these risks through explicit scope notes, controls, manifests, task/versioning discipline, and separate code and data licenses.",
  "rai:hasSyntheticData": true,
  "rai:dataCollection": "The dataset was produced by author-defined synthetic software task specifications, source-traced multiple-choice question banks, benchmark harness executions, and deterministic analysis projections from append-only run records.",
  "rai:dataPreprocessingProtocol": "Append-only run records were sanitized into canonical CSV and JSON tables under runs_release/tables. The table manifest records source paths, row counts, table hashes, schema version, generated time, and transform provenance.",
  "rai:dataAnnotationProtocol": "Question banks and gold answers were authored and manually reviewed by the benchmark authors. No crowdsourced annotation or human-subject labeling was used.",
  "rai:dataReleaseMaintenancePlan": "The reported artifact is a fixed release. Task packs and canonical tables are versioned; corrections to specifications, questions, gold answers, or analysis transforms should be released as new evidence layers while preserving prior records.",
  "prov:wasDerivedFrom": [
